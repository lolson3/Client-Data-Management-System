{
  "name": "client-data-management-system",
  "version": "1.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6030",
    "build": "npm run docs:generate && next build",
    "start": "node scripts/start-standalone.js",
    "start:standalone": "node scripts/start-standalone.js",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx tests/all.test.ts",
    "validate": "npm run lint && npm run test && tsc --noEmit && next build",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed-employees": "tsx scripts/seed-employees.ts",
    "build:standalone": "npm run docs:generate && node scripts/package-standalone.js",
    "sync-version": "node scripts/sync-version.js",
    "electron:start": "electron electron-app",
    "electron:build": "node scripts/sync-version.js && npm --prefix electron-app install && electron-builder --config electron-builder.json",
    "server:installer": "node scripts/build-server-installer.js",
    "build:all": "npm run clean && npm run build && npm run build:standalone && npm run electron:build && npm run server:installer && node scripts/copy-to-distribute.js",
    "clean": "node -e \"const fs=require('fs'); ['dist-electron','dist-server','temp-server-build','.next'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('Cleaned: '+d)}})\"",
    "clean:all": "npm run clean && node -e \"const fs=require('fs'); ['.node-portable','.next'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('Cleaned: '+d)}})\"",
    "db:reset": "tsx scripts/reset-database.ts",
    "auth:init": "tsx scripts/init-auth-db.ts",
    "preferences:init": "tsx scripts/init-preferences-db.ts",
    "misc:migrate": "tsx scripts/migrate-misc.ts",
    "users": "tsx scripts/users.ts",
    "docs:generate": "tsx scripts/generate-api-docs.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.469.0",
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.17",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "next-swagger-doc": "^0.4.1",
    "postcss": "^8.4.33",
    "swagger-ui-dist": "^5.32.8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "main": "electron-main.js",
  "config": {
    "defaultTheme": "standard",
    "defaultColorMode": "system"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
